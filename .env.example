# =====================================================================
#  Shanti Hospital — environment configuration
#
#  Copy this file to `.env.local` and fill in the two values.
#  `.env.local` is gitignored: never commit real credentials.
#
#  With these UNSET the app runs in "local mode" — seed data in
#  localStorage, demo admin passcode. Nothing breaks.
#  With these SET it runs in "cloud mode" — Postgres is the source of
#  truth and staff sign in with real accounts.
#
#  After changing this file you MUST restart `npm start`.
#  Create React App only reads env vars at startup.
# =====================================================================

# Project URL — Supabase dashboard → Project Settings → API
REACT_APP_SUPABASE_URL=

# The "anon" / public key from the same page.
#
# This key is safe to ship in a browser bundle: it grants nothing on its
# own. Row Level Security (see supabase/schema.sql) decides what it can
# actually read and write.
#
# NEVER put the `service_role` key here. That one bypasses RLS entirely
# and would expose every patient record to anyone who opened DevTools.
REACT_APP_SUPABASE_ANON_KEY=
